{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"],
      "@paygate/domain": ["./packages/domain/src/index.ts"],
      "@paygate/domain/*": ["./packages/domain/src/*"],
      "@paygate/contracts": ["./packages/contracts/src/index.ts"],
      "@paygate/contracts/*": ["./packages/contracts/src/*"],
      "@paygate/i18n": ["./packages/i18n/src/index.ts"],
      "@paygate/i18n/*": ["./packages/i18n/src/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
